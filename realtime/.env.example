PORT=4000
CORS_ORIGINS=*
# Same values as the Laravel .env
JWT_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=padanam
DB_USERNAME=root
DB_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379
# Laravel ↔ Node shared secret (REALTIME_INTERNAL_KEY in Laravel)
INTERNAL_KEY=change-me
LARAVEL_URL=http://127.0.0.1:8000
# WebRTC (voice/video). Add a TURN server for users behind strict mobile networks.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
# Anti-spam
MSG_RATE_LIMIT=20
MSG_RATE_WINDOW_SEC=10
MAX_MESSAGE_LENGTH=4000
